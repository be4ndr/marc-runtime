{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewer result",
  "description": "Immutable invocation-bound semantic wire result. Runtime/process failures are not semantic outcomes. SQLite is persistence authority.",
  "allOf": [
    {"$ref": "role-result-common.schema.json#/$defs/envelope"}
  ],
  "type": "object",
  "properties": {
    "role": {"const": "REVIEWER"},
    "outcome": {
      "enum": ["approved", "changes_required", "inconclusive"]
    },
    "finding_occurrences": {
      "type": "array",
      "items": {"$ref": "role-result-common.schema.json#/$defs/findingOccurrence"},
      "uniqueItems": true
    }
  },
  "required": [
    "finding_occurrences"
  ],
  "unevaluatedProperties": false
}

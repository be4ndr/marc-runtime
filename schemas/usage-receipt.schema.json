{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized ProviderCall usage receipt",
  "description": "Immutable cumulative provider-reported evidence for one registered physical call. Wire validation is not accounting authority; SQLite owns current usage. The decoder also enforces payload size and base-10 int64 numeric syntax.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "run_id", "invocation_id", "provider_call_id", "source", "model", "reported_at", "state", "input_tokens", "cached_input_tokens", "output_tokens"],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_id": { "$ref": "#/$defs/identifier" },
    "run_id": { "$ref": "#/$defs/identifier" },
    "invocation_id": { "$ref": "#/$defs/identifier" },
    "provider_call_id": { "$ref": "#/$defs/identifier" },
    "source": { "$ref": "#/$defs/label" },
    "model": { "$ref": "#/$defs/label" },
    "provider_receipt_id": { "anyOf": [{ "$ref": "#/$defs/label" }, { "type": "null" }] },
    "reported_at": {
      "type": "string", "maxLength": 35, "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "state": { "enum": ["unknown", "partial", "final"] },
    "input_tokens": { "$ref": "#/$defs/counter" },
    "cached_input_tokens": { "$ref": "#/$defs/counter" },
    "output_tokens": { "$ref": "#/$defs/counter" },
    "reasoning_tokens": { "$ref": "#/$defs/counter" }
  },
  "$defs": {
    "identifier": { "$ref": "role-result-common.schema.json#/$defs/identifier" },
    "label": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S" },
    "counter": {
      "description": "NULL is unavailable. Otherwise a non-negative base-10 int64 JSON integer literal; no fraction, exponent, string or estimated counter.",
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 9223372036854775807
    }
  }
}
